# Public site identity. These values are compiled into the browser bundle.
VITE_SITE_NAME=OpenGateway Starter
VITE_SITE_DESCRIPTION=A reusable React starter for AI gateway sites and clearly labeled product demos.
VITE_SITE_URL=https://starter.example.com

# Public repository links used by the footer and documentation.
VITE_REPOSITORY_URL=https://github.com/YouRen1320/open-gateway-starter

# Optional JSON endpoint described in docs/CONFIGURATION.md.
VITE_STATUS_ENDPOINT=

# Set to false to hide all demo links and exclude them from navigation.
VITE_ENABLE_DEMO=true
